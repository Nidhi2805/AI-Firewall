# ---- Copy this file to .env and fill in your own values. ----
# .env is gitignored and must NEVER be committed.

# Primary LLM: Groq (fast). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Model IDs change often. List what YOUR account supports with:
#   python scripts/list_models.py
# then set a chat model you have access to. Common fast choice:
GROQ_MODEL=openai/gpt-oss-20b

# Fallback LLM: Gemini (also powers native-PDF answering for scanned docs).
# Optional but recommended. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-flash-latest

# Which provider to try first: groq | gemini | auto  (default: auto)
LLM_PROVIDER=auto

# Flask session secret — set to any long random string.
APP_SECRET=change-this-to-a-long-random-string
